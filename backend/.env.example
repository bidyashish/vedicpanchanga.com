# Backend env (development defaults).
# `make install` copies this to backend/.env if one doesn't exist; setup-vps.sh
# writes the production .env on the server. Both are gitignored - real config
# never lives in git.

# CORS_ORIGINS: comma-separated allowlist for the FastAPI CORS middleware.
# Development: the Vite dev server. Production (written by setup-vps.sh):
# vedicpanchanga.com. Add third-party browser-app origins here when granting
# them API keys.
CORS_ORIGINS=http://localhost:3121,http://127.0.0.1:3121

# Optional API-key auth (see backend/auth.py). Unset = API fully open.
# Comma-separated keys; clients send "Authorization: Bearer <key>" or
# "X-API-Key: <key>". Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# On the server, put real keys in backend/.env.local - it is gitignored,
# loaded on top of .env, and never rewritten by setup-vps.sh.
#API_KEYS=

# Origins allowed to call without a key (the site's own frontend).
# Defaults to vedicpanchanga.com + localhost dev; override only if needed.
#AUTH_EXEMPT_ORIGINS=

# ───────────────────────── Accounts (backend/accounts/) ─────────────────────
# Everything below is optional. With SESSION_SECRET unset the site behaves
# exactly as before: no sign-in UI, no database writes. Put real values in
# backend/.env.local on the server (gitignored, survives deploys).

# Master switch + cookie signing key. Must be identical for all uvicorn
# workers and stable across restarts (setup-vps.sh generates one on first
# deploy). Generate locally with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#SESSION_SECRET=

# SQLite file for users / saved charts. Default: backend/data/app.db
#DATABASE_PATH=

# Public origin used in password-reset emails and Stripe redirect URLs.
#PUBLIC_URL=https://vedicpanchanga.com

# Google Sign-In: OAuth 2.0 "Web application" client ID from
# console.cloud.google.com → APIs & Services → Credentials. Add the site
# origin (and http://localhost:3121 for dev) under "Authorized JavaScript
# origins". Unset = no Google button.
#GOOGLE_CLIENT_ID=

# Password-reset mail through Resend (https://resend.com, HTTP API, no SMTP).
# Verify your sending domain in the Resend dashboard, create an API key and
# paste it here. MAIL_FROM must be on that verified domain. Unset
# RESEND_API_KEY = "forgot password" is hidden in the UI.
#RESEND_API_KEY=
#MAIL_FROM=Vedic Panchanga <no-reply@vedicpanchanga.com>

# Stripe subscription that removes ads. Create one Product with a monthly
# and a yearly recurring Price; paste the price_... ids. Webhook endpoint:
# https://vedicpanchanga.com/api/billing/webhook listening to
# checkout.session.completed + customer.subscription.*
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
#STRIPE_PRICE_MONTHLY=
#STRIPE_PRICE_YEARLY=

# Off-box replica of the SQLite database in Cloudflare D1, pushed every
# 15 minutes by panchanga-backup.timer (python -m accounts.backup sync).
#   wrangler d1 create panchanga-accounts      -> copy the database_id below
# CLOUDFLARE_API_TOKEN needs the "D1 Edit" permission (dashboard: My Profile,
# API Tokens). Same variable names wrangler uses. Unset = no replica.
#CLOUDFLARE_ACCOUNT_ID=
#CLOUDFLARE_API_TOKEN=
#D1_DATABASE_ID=
